#!/usr/bin/env bash
# Change le fond d'écran GNOME selon la météo wttr.in (catégorie + jour/nuit).
#
# Usage : meteo-wallpaper [--code N] [--jour|--nuit]
#   --code N   force un weatherCode wttr.in (test des wallpapers sans attendre l'orage)
#   --jour     force la variante jour
#   --nuit     force la variante nuit
#   --dry-run  affiche le fichier choisi sans toucher au fond d'écran
#
# Fichiers attendus dans WALLPAPER_DIR (extension libre : png, jpg, webp...) :
#   soleil-jour  nuageux-jour  pluie-jour  orage-jour  neige-jour  brouillard-jour
#   soleil-nuit  nuageux-nuit  pluie-nuit  orage-nuit  neige-nuit  brouillard-nuit
#   defaut       (repli si une variante manque)

set -euo pipefail

# Valeurs par défaut, surchargées par le fichier de config
CITY="Lyon"
WALLPAPER_DIR="$HOME/Images/paint-weather"
PROXY=""

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/meteo-wallpaper/config"
# shellcheck source=/dev/null
[[ -f "$CONFIG" ]] && source "$CONFIG"

log() { echo "meteo-wallpaper: $*" >&2; }

force_code=""
force_moment=""
dry=0
while (($#)); do
    case "$1" in
        --code) force_code="$2"; shift 2 ;;
        --jour) force_moment="jour"; shift ;;
        --nuit) force_moment="nuit"; shift ;;
        --dry-run) dry=1; shift ;;
        *) log "option inconnue : $1"; exit 2 ;;
    esac
done

# Regroupe les weatherCode WWO renvoyés par wttr.in en 6 catégories
# https://github.com/chubin/wttr.in/blob/master/internal/renderer/oneline/constants.go
categorie() {
    case "$1" in
        113|116) echo soleil ;;
        119|122) echo nuageux ;;
        143|248|260) echo brouillard ;;
        200|386|389|392|395) echo orage ;;
        179|182|185|227|230|317|320|323|326|329|332|335|338|350|362|365|368|371|374|377) echo neige ;;
        176|263|266|281|284|293|296|299|302|305|308|311|314|353|356|359) echo pluie ;;
        *) echo nuageux ;;
    esac
}

# Premier fichier correspondant à un nom de base, quelle que soit l'extension
trouver() {
    local fichiers
    shopt -s nullglob
    fichiers=("$WALLPAPER_DIR/$1".*)
    shopt -u nullglob
    ((${#fichiers[@]})) && echo "${fichiers[0]}"
}

# Téléchargement avec curl, ou wget à défaut (aucune dépendance à installer)
telecharger() {
    if command -v curl >/dev/null; then
        curl -fsS --max-time 15 --retry 3 --retry-delay 5 ${PROXY:+-x "$PROXY"} "$1"
    elif command -v wget >/dev/null; then
        ${PROXY:+env https_proxy="$PROXY"} wget -qO- --timeout=15 --tries=3 "$1"
    else
        log "ni curl ni wget disponible"
        return 1
    fi
}

# Première valeur d'une clé dans le JSON j1 de wttr.in.
# Dans j1, current_condition précède weather : la première occurrence de
# weatherCode est la météo actuelle, celle de sunrise/sunset est aujourd'hui.
champ() {
    grep -oE "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" <<<"$json" \
        | head -n1 | sed -E 's/.*:[[:space:]]*"([^"]*)"/\1/' || true
}

# Récupération météo (sauf si tout est forcé)
json=""
if [[ -z "$force_code" || -z "$force_moment" ]]; then
    if ! json=$(telecharger "https://wttr.in/${CITY// /+}?format=j1"); then
        log "wttr.in injoignable, fond d'écran inchangé"
        exit 0
    fi
fi

code="${force_code:-$(champ weatherCode)}"
if [[ -z "$code" ]]; then
    log "réponse wttr.in illisible, fond d'écran inchangé"
    exit 0
fi
cat="$(categorie "$code")"

if [[ -n "$force_moment" ]]; then
    moment="$force_moment"
else
    sunrise=$(champ sunrise)
    sunset=$(champ sunset)
    now=$(date +%s)
    # wttr.in donne les heures dans le fuseau de la ville. on peut pas tout deviner non plus
    heure='^[0-9]{1,2}:[0-9]{2}( [AP]M)?$'
    if [[ "$sunrise" =~ $heure && "$sunset" =~ $heure ]] \
       && lever=$(date -d "$sunrise" +%s 2>/dev/null) \
       && coucher=$(date -d "$sunset" +%s 2>/dev/null); then
        if ((now >= lever && now < coucher)); then moment=jour; else moment=nuit; fi
    else
        moment=jour
    fi
fi

fichier="$(trouver "$cat-$moment" || trouver "$cat-jour" || trouver defaut || true)"
if [[ -z "$fichier" ]]; then
    log "aucun wallpaper pour $cat-$moment dans $WALLPAPER_DIR"
    exit 1
fi

if ((dry)); then
    echo "$CITY : code $code -> $cat/$moment -> $fichier"
    exit 0
fi

uri="file://$fichier"
if [[ "$(gsettings get org.gnome.desktop.background picture-uri)" != "'$uri'" ]]; then
    gsettings set org.gnome.desktop.background picture-uri "$uri"
    gsettings set org.gnome.desktop.background picture-uri-dark "$uri"
    log "$CITY : code $code -> $cat/$moment -> $(basename "$fichier")"
fi
